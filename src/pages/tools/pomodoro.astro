---
// 番茄时钟 - 独立页面，脱离框架布局
const videoImports = import.meta.glob(
  "/src/assets/videos/fanqie/*.mp4",
  { eager: true, query: "?url", import: "default" }
);
const imageImports = import.meta.glob(
  "/src/assets/images/fanqieimages/*.{png,jpg,jpeg,avif,webp}",
  { eager: true, query: "?url", import: "default" }
);

const videos = Object.values(videoImports) as string[];
const images = Object.values(imageImports) as string[];
const allWallpapers = [...videos, ...images];

// 只有有媒体时才导入第一个
const defaultBg = allWallpapers[0] || "";
const hasVideos = videos.length > 0;
const hasImages = images.length > 0;

const modes = [
  { id: "focus", label: "专注", minutes: 25 },
  { id: "short", label: "短休息", minutes: 5 },
  { id: "long", label: "长休息", minutes: 15 },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>番茄时钟</title>
  <style>
    .pomodoro-page {
      /* ----- design tokens (replicated from variables.styl) ----- */
      --hue: 280;
      --primary: oklch(0.75 0.14 var(--hue));
      --page-bg: oklch(0.16 0.014 var(--hue));
      --card-bg: oklch(0.23 0.015 var(--hue));
      --surface-glass: oklch(0.25 0.02 var(--hue));
      --btn-regular-bg: oklch(0.33 0.035 var(--hue));
      --btn-regular-bg-hover: oklch(0.38 0.04 var(--hue));
      --btn-regular-bg-active: oklch(0.43 0.045 var(--hue));
      --float-panel-bg: oklch(0.19 0.015 var(--hue));
      --line-divider: oklch(1 0 0 / 0.08);
      --radius-xl: 0.75rem;
      --radius-2xl: 1rem;
      --radius-3xl: 1.5rem;
      --radius-full: 9999px;
      --blur-md: 8px;
      --blur-lg: 12px;
      --blur-xl: 16px;
      --blur-2xl: 20px;
      --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
      --duration-fast: 100ms;
      --duration-medium: 200ms;

      margin: 0; padding: 0; box-sizing: border-box;
      height: 100vh; height: 100dvh;
      overflow: hidden;
      position: relative;
      font-family: system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(ellipse 80% 60% at 50% 35%,
          color-mix(in oklch, var(--primary) 12%, transparent) 0%,
          oklch(0.14 0.014 var(--hue)) 100%);
    }
    .pomodoro-page :where(*) { margin: 0; padding: 0; box-sizing: border-box; }

    /* 视频背景 */
    #bg-video {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover; z-index: -1;
    }
    /* 图片背景 */
    #bg-image {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover; z-index: -1;
    }
    #bg-image.hidden { display: none; }

    .overlay {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      background-color: oklch(0 0 0 / 0.4);
      z-index: 0;
    }

    .content-container {
      position: relative; z-index: 1;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      height: 100vh; height: 100dvh;
      color: white; user-select: none;
    }

    /* 模式选择 */
    .mode-selector {
      display: flex; gap: 8px;
      border-radius: 30px; padding: 5px;
      margin-bottom: 24px;
    }
    .mode-btn {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.5);
      padding: 10px 22px; border-radius: 25px;
      cursor: pointer; font-size: 14px;
      transition: all var(--duration-medium) var(--ease-standard);
      white-space: nowrap;
    }
    .mode-btn.active {
      background: transparent;
      color: var(--primary); font-weight: 600;
    }
    .mode-btn:hover:not(.active) {
      background: transparent; color: var(--primary);
    }

    /* 计时器卡片 */
    .timer-card {
      display: flex; flex-direction: column; align-items: center;
      gap: 12px;
    }
    .timer-display {
      font-size: clamp(4rem, 12vw, 9rem);
      font-weight: 300; letter-spacing: 4px;
      text-shadow: 0 0 60px color-mix(in oklch, var(--primary) 30%, transparent),
                   0 0 120px color-mix(in oklch, var(--primary) 15%, transparent);
      font-variant-numeric: tabular-nums;
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* 番茄进度点 */
    .session-dots {
      display: flex; gap: 10px;
    }
    .session-dot {
      width: 10px; height: 10px;
      border-radius: 50%;
      background: oklch(1 0 0 / 0.2);
      border: 1.5px solid oklch(1 0 0 / 0.35);
      transition: all 0.3s ease;
    }
    .session-dot.done {
      background: var(--primary);
      border-color: var(--primary);
      box-shadow: 0 0 8px color-mix(in oklch, var(--primary) 50%, transparent);
    }
    .session-hint {
      font-size: 14px; color: oklch(1 0 0 / 0.55);
      height: 20px;
      transition: all var(--duration-medium) var(--ease-standard);
    }

    /* 控制按钮 */
    .controls {
      display: flex; gap: 16px; align-items: center;
    }
    #start-btn {
      width: 72px; height: 72px;
      border-radius: 50%;
      background: transparent;
      border: 2px solid var(--primary);
      color: var(--primary); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all var(--duration-medium) var(--ease-standard);
    }
    #start-btn:hover {
      background: transparent;
      border-color: color-mix(in oklch, var(--primary) 70%, transparent);
      transform: scale(1.05);
    }
    #start-btn svg { width: 32px; height: 32px; }

    .ctrl-btn {
      background: transparent;
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.7); padding: 10px 20px;
      border-radius: 25px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      display: flex; align-items: center; gap: 6px;
    }
    .ctrl-btn:hover { background: transparent; color: var(--primary); }
    .ctrl-btn svg { width: 18px; height: 18px; }

    .hidden { display: none !important; }
    .flex { display: flex !important; }

    /* 返回按钮 */
    .back-btn {
      position: fixed; top: 24px; left: 24px; z-index: 1000;
      background: transparent;
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.7); padding: 8px 16px;
      border-radius: 20px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      text-decoration: none; display: flex; align-items: center; gap: 4px;
    }
    .back-btn:hover { background: transparent; color: var(--primary); }
    .back-btn svg { width: 16px; height: 16px; }

    /* 底部按钮 */
    .bottom-bar {
      position: fixed; bottom: 28px; left: 0; right: 60px;
      display: flex; justify-content: space-between; align-items: center;
      padding: 0 28px 0 48px; z-index: 1000;
    }
    .bottom-group { display: flex; gap: 10px; align-items: center; }
    .media-type-badge {
      background: transparent;
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.7);
      padding: 8px 14px; border-radius: 20px;
      font-size: 12px;
    }

    /* 右上角音乐图标 — 匹配导航栏 #music-player-switch */
    .music-toggle {
      position: fixed; top: 20px; right: 20px; z-index: 1000;
      background: transparent;
      border: none;
      color: oklch(1 0 0 / 0.7); width: 44px; height: 44px;
      border-radius: 8px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.15s;
    }
    .music-toggle:hover { color: white; }
    .music-toggle:active { transform: scale(0.9); }
    .music-toggle svg { width: 20px; height: 20px; position: relative; z-index: 1; }
    .music-toggle.music-playing { color: var(--primary); }
    .music-toggle.music-playing::before {
      content: '';
      position: absolute; inset: 2px;
      border-radius: 50%;
      border: 2px solid transparent;
      border-top-color: var(--primary);
      border-right-color: color-mix(in oklch, var(--primary) 60%, transparent);
      animation: discSpin 1s linear infinite;
    }
    @keyframes discSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    /* 音乐飞窗 — 匹配 navbar float-panel + MusicPlayer 布局 */
    .music-flyout {
      position: fixed; top: 72px; right: 20px; z-index: 999;
      width: 320px;
      background: var(--float-panel-bg);
      border-radius: 16px;
      border: 1px solid oklch(1 0 0 / 0.1);
      padding: 14px;
      box-shadow: 0 20px 25px -5px oklch(0 0 0 / 0.1), 0 8px 10px -6px oklch(0 0 0 / 0.1);
      display: flex; flex-direction: column; gap: 8px;
      opacity: 0; transform: translateY(-4px); pointer-events: none;
      transition: opacity 0.15s, transform 0.15s;
      max-height: 80vh; overflow-y: auto;
    }
    .music-flyout.open {
      opacity: 1; transform: translateY(0); pointer-events: auto;
    }

    /* 封面 + 信息行 */
    .music-flyout-top {
      display: flex; align-items: center; gap: 10px;
    }
    .music-flyout-cover {
      width: 48px; height: 48px; flex-shrink: 0;
      border-radius: 50%; overflow: hidden;
      border: 2px solid oklch(1 0 0 / 0.1);
      background: color-mix(in oklch, var(--primary) 10%, transparent);
      display: flex; align-items: center; justify-content: center;
      position: relative; cursor: pointer;
    }
    .music-flyout-cover .cover-placeholder {
      width: 22px; height: 22px; color: color-mix(in oklch, var(--primary) 30%, transparent);
    }
    .music-flyout-cover img {
      position: absolute; inset: 0;
      width: 100%; height: 100%; object-fit: cover;
      border-radius: 50%;
    }
    .music-flyout-info {
      flex: 1; min-width: 0; display: flex; flex-direction: column;
    }
    .music-flyout-title-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: 4px;
    }
    .music-flyout-title {
      font-size: 15px; font-weight: 700;
      color: oklch(1 0 0 / 0.9);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      cursor: pointer; flex: 1; min-width: 0;
    }
    .music-flyout-title:hover { color: var(--primary); }
    .music-lyric-toggle {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.35); width: 28px; height: 28px;
      border-radius: 6px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s; flex-shrink: 0;
      padding: 0;
    }
    .music-lyric-toggle:hover { color: var(--primary); }
    .music-lyric-toggle:active { transform: scale(0.9); }
    .music-lyric-toggle svg { width: 20px; height: 20px; }
    .music-lyric-toggle.active { color: var(--primary); }
    .music-flyout-artist {
      font-size: 11px; color: oklch(1 0 0 / 0.45);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 1px;
    }
    .music-flyout-time {
      font-size: 10px; color: oklch(1 0 0 / 0.35);
      font-family: 'JetBrains Mono', 'SF Mono', monospace;
      margin-top: 2px;
      display: flex; align-items: center; gap: 0;
    }
    .time-sep { opacity: 0.5; margin: 0 2px; }

    /* 音量控制 */
    .music-vol-row {
      display: flex; align-items: center; gap: 4px;
      margin-left: 12px;
    }
    .music-mute-btn {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.35); width: 22px; height: 22px;
      border-radius: 4px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: color 0.15s; padding: 0; flex-shrink: 0;
    }
    .music-mute-btn:hover { color: var(--primary); }
    .music-mute-btn svg { width: 15px; height: 15px; }
    .music-vol-slider {
      width: 56px; height: 3px;
      background: oklch(1 0 0 / 0.12);
      border-radius: 2px; cursor: pointer;
      position: relative;
    }
    .music-vol-bar {
      height: 100%; width: 70%;
      background: var(--primary); border-radius: 2px;
      transition: width 0.1s;
    }

    /* 进度条 */
    .music-progress-container {
      width: 100%; height: 4px;
      background: oklch(1 0 0 / 0.1);
      border-radius: 2px; cursor: pointer;
      position: relative;
    }
    .music-progress-bar {
      height: 100%; width: 0%;
      background: var(--primary); border-radius: 2px;
      transition: width 0.1s linear;
    }

    /* 控制按钮行 */
    .music-flyout-controls {
      display: flex; align-items: center; justify-content: space-between;
    }
    .music-flyout-btn {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.45); width: 34px; height: 34px;
      border-radius: 8px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s; flex-shrink: 0;
    }
    .music-flyout-btn:hover { background: oklch(1 0 0 / 0.08); color: oklch(1 0 0 / 0.8); }
    .music-flyout-btn:active { transform: scale(0.9); }
    .music-flyout-btn svg { width: 18px; height: 18px; }
    .music-flyout-btn-play {
      width: 42px; height: 42px;
      background: color-mix(in oklch, var(--primary) 15%, transparent);
      border: none; border-radius: 50%;
      color: var(--primary); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s; flex-shrink: 0;
    }
    .music-flyout-btn-play:hover { background: color-mix(in oklch, var(--primary) 25%, transparent); }
    .music-flyout-btn-play svg { width: 22px; height: 22px; }

    /* 展开抽屉（歌词 / 播放列表）— grid 动画 */
    .music-drawer {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.3s ease;
      opacity: 0;
      transition: grid-template-rows 0.3s ease, opacity 0.3s ease;
    }
    .music-drawer.open {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .music-drawer-inner {
      overflow: hidden; min-height: 0;
    }
    .music-drawer-content {
      max-height: 180px; overflow-y: auto;
      border-top: 1px solid oklch(1 0 0 / 0.06);
      padding-top: 8px; margin-top: 2px;
    }
    .music-drawer-content::-webkit-scrollbar { width: 4px; }
    .music-drawer-content::-webkit-scrollbar-thumb {
      background: color-mix(in oklch, var(--primary) 20%, transparent); border-radius: 4px;
    }

    /* 歌词样式 */
    .lyric-scroll {
      display: flex; flex-direction: column; align-items: center;
      gap: 4px; padding: 8px 4px;
    }
    .lyric-placeholder {
      color: oklch(1 0 0 / 0.3); font-size: 12px; padding: 16px 0;
      text-align: center; width: 100%;
    }

    /* 播放列表抽屉 — 独立浮动面板，参考 MusicPlayer */
    .playlist-overlay {
      position: fixed; inset: 0; z-index: 2000;
      background: oklch(0 0 0 / 0.45);
      display: none; align-items: center; justify-content: center;
    }
    .playlist-overlay.show { display: flex; }
    .playlist-drawer {
      width: 380px; max-width: 90vw; max-height: 70vh;
      background: var(--float-panel-bg);
      border-radius: 16px;
      border: 1px solid oklch(1 0 0 / 0.1);
      overflow: hidden; display: flex; flex-direction: column;
      box-shadow: 0 20px 25px -5px oklch(0 0 0 / 0.3);
    }
    .playlist-header {
      display: flex; justify-content: space-between; align-items: center;
      padding: 16px 20px;
      border-bottom: 1px solid oklch(1 0 0 / 0.06);
      color: oklch(1 0 0 / 0.85); font-size: 14px; font-weight: 600;
      flex-shrink: 0;
    }
    .playlist-close {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.4); width: 32px; height: 32px;
      border-radius: 6px; cursor: pointer; font-size: 20px;
      display: flex; align-items: center; justify-content: center;
      transition: all 0.15s;
    }
    .playlist-close:hover { background: oklch(1 0 0 / 0.08); color: oklch(1 0 0 / 0.8); }
    .playlist-list {
      flex: 1; overflow-y: auto; padding: 8px;
    }
    .playlist-list::-webkit-scrollbar { width: 5px; }
    .playlist-list::-webkit-scrollbar-track { background: transparent; }
    .playlist-list::-webkit-scrollbar-thumb {
      background: color-mix(in oklch, var(--primary) 25%, transparent); border-radius: 9999px;
    }
    .playlist-list::-webkit-scrollbar-thumb:hover {
      background: color-mix(in oklch, var(--primary) 40%, transparent);
    }
  </style>
  <style is:global>
    /* 歌词行 — JS 动态创建 */
    .lyric-line {
      color: oklch(1 0 0 / 0.35); font-size: 15px;
      font-weight: 500; transition: all 0.3s;
      padding: 4px 0; cursor: default;
      text-align: center; width: 100%;
    }
    .lyric-line.active {
      color: var(--primary); font-size: 17px; font-weight: 700;
    }

    /* 迷你播放列表项 — JS 动态创建 */
    .mini-playlist-item {
      display: flex; align-items: center; gap: 10px;
      padding: 8px 8px; border-radius: 8px; cursor: pointer;
      transition: background 0.15s;
    }
    .mini-playlist-item:hover { background: oklch(1 0 0 / 0.05); }
    .mini-playlist-item.active { background: color-mix(in oklch, var(--primary) 10%, transparent); }
    .mini-playlist-cover {
      width: 28px; height: 28px; flex-shrink: 0;
      border-radius: 4px; overflow: hidden;
      background: oklch(1 0 0 / 0.08);
      position: relative;
    }
    .mini-playlist-cover img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .mini-playlist-cover-overlay {
      position: absolute; inset: 0;
      background: color-mix(in oklch, var(--primary) 20%, transparent);
      display: none; align-items: center; justify-content: center;
    }
    .mini-playlist-item.active .mini-playlist-cover-overlay { display: flex; }
    .mini-playlist-info { flex: 1; min-width: 0; overflow: hidden; }
    .mini-playlist-name {
      font-size: 13px; font-weight: 400; color: oklch(1 0 0 / 0.55);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      transition: color 0.15s;
    }
    .mini-playlist-item:hover .mini-playlist-name { color: var(--primary); }
    .mini-playlist-item.active .mini-playlist-name { color: var(--primary); }
    .mini-playlist-artist {
      font-size: 11px; color: oklch(1 0 0 / 0.35);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      margin-top: 1px;
      transition: color 0.15s;
    }
    .mini-playlist-item:hover .mini-playlist-artist { color: oklch(1 0 0 / 0.5); }

    /* 全屏播放列表项 — JS 动态创建 */
    .playlist-item {
      display: flex; align-items: center; gap: 12px;
      padding: 8px 12px; cursor: pointer;
      transition: background 0.15s ease;
      border-radius: 8px;
    }
    .playlist-item:hover {
      background: oklch(1 0 0 / 0.05);
    }
    .playlist-item.active {
      background: color-mix(in oklch, var(--primary) 10%, transparent);
    }
    .playlist-cover {
      width: 28px; height: 28px; flex-shrink: 0;
      border-radius: 4px; overflow: hidden;
      background: oklch(1 0 0 / 0.08);
      position: relative;
    }
    .playlist-cover img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .playlist-cover-overlay {
      position: absolute; inset: 0;
      background: color-mix(in oklch, var(--primary) 20%, transparent);
      display: none; align-items: center; justify-content: center;
    }
    .playlist-item.active .playlist-cover-overlay { display: flex; }
    .eq-bars {
      display: flex; align-items: flex-end; gap: 2px; height: 14px;
    }
    .eq-bar {
      width: 3px; background: var(--primary); border-radius: 1px;
      animation: eq-bounce 0.9s ease-in-out infinite;
    }
    .eq-bar:nth-child(1) { animation-delay: 0s; }
    .eq-bar:nth-child(2) { animation-delay: 0.2s; }
    .eq-bar:nth-child(3) { animation-delay: 0.4s; }
    @keyframes eq-bounce {
      0%, 100% { height: 4px; }
      50% { height: 14px; }
    }
    .playlist-item-info { flex: 1; min-width: 0; overflow: hidden; }
    .playlist-item-name {
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      font-size: 13px; font-weight: 400;
      color: oklch(1 0 0 / 0.55);
      transition: color 0.15s;
    }
    .playlist-item:hover .playlist-item-name { color: var(--primary); }
    .playlist-item.active .playlist-item-name { color: var(--primary); }
    .playlist-item-artist {
      font-size: 11px; font-weight: 400;
      color: oklch(1 0 0 / 0.4); white-space: nowrap;
      overflow: hidden; text-overflow: ellipsis;
      margin-top: 1px;
    }
    .playlist-item:hover .playlist-item-artist { color: oklch(1 0 0 / 0.55); }
    .playlist-item-duration {
      font-size: 10px; color: oklch(1 0 0 / 0.3);
      font-family: 'JetBrains Mono', monospace; flex-shrink: 0;
    }
  </style>
</head>
<body class="pomodoro-page">
  <script>!function(){var h=localStorage.getItem("hue");if(h)document.documentElement.style.setProperty("--hue",h)}();</script>

  <!-- 视频背景 -->
  <video id="bg-video" autoplay muted loop playsinline class={hasVideos ? "" : "hidden"}>
    {videos.length > 0 && <source src={videos[0]} type="video/mp4" />}
  </video>

  <!-- 图片背景 -->
  <img
    id="bg-image"
    src={hasImages ? images[0] : (hasVideos ? "" : "")}
    alt=""
    class={!hasVideos && hasImages ? "" : "hidden"}
  />

  <!-- 半透明覆盖 -->
