---
// 白噪音 - 独立页面，脱离框架布局
import rainVideo from "@/assets/videos/rain.mp4";
import rain2Video from "@/assets/videos/rain2.mp4";
import windVideo from "@/assets/videos/wind.mp4";

const noiseTypes = [
  { id: "white", label: "白噪音", desc: "均匀覆盖所有频率", video: rain2Video },
  { id: "pink", label: "粉噪音", desc: "柔和自然，适合放松", video: rainVideo },
  { id: "brown", label: "棕噪音", desc: "深沉低频，如瀑布雷鸣", video: windVideo },
];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>白噪音</title>
  <style>
    .whitenoise-page {
      /* ----- design tokens ----- */
      --hue: 280;
      --primary: oklch(0.75 0.14 var(--hue));
      --page-bg: oklch(0.16 0.014 var(--hue));
      --card-bg: oklch(0.23 0.015 var(--hue));
      --surface-glass: oklch(0.25 0.02 var(--hue));
      --btn-regular-bg: oklch(0.33 0.035 var(--hue));
      --btn-regular-bg-hover: oklch(0.38 0.04 var(--hue));
      --btn-regular-bg-active: oklch(0.43 0.045 var(--hue));
      --float-panel-bg: oklch(0.19 0.015 var(--hue));
      --line-divider: oklch(1 0 0 / 0.08);
      --radius-xl: 0.75rem;
      --radius-2xl: 1rem;
      --radius-3xl: 1.5rem;
      --radius-full: 9999px;
      --blur-md: 8px;
      --blur-lg: 12px;
      --blur-xl: 16px;
      --blur-2xl: 20px;
      --ease-standard: cubic-bezier(0.4, 0, 0.2, 1);
      --duration-fast: 100ms;
      --duration-medium: 200ms;

      margin: 0; padding: 0; box-sizing: border-box;
      height: 100vh; height: 100dvh;
      overflow: hidden;
      position: relative;
      font-family: system-ui, -apple-system, sans-serif;
      background:
        radial-gradient(ellipse 80% 60% at 50% 35%,
          color-mix(in oklch, var(--primary) 12%, transparent) 0%,
          oklch(0.14 0.014 var(--hue)) 100%);
    }
    .whitenoise-page :where(*) { margin: 0; padding: 0; box-sizing: border-box; }

    /* ---- Glass card panel ---- */
    .glass-card {
      background: oklch(1 0 0 / 0.1);
      border: 1px solid oklch(1 0 0 / 0.15);
      border-radius: var(--radius-2xl);
      padding: 28px 36px;
      display: flex; flex-direction: column; align-items: center;
    }
    #video-bg {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      object-fit: cover;
      z-index: -1;
    }
    .video-fallback {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -1;
      background:
        radial-gradient(ellipse 80% 60% at 50% 35%,
          color-mix(in oklch, var(--primary) 12%, transparent) 0%,
          oklch(0.14 0.014 var(--hue)) 100%);
      display: none;
    }
    .overlay {
      position: absolute; top: 0; left: 0;
      width: 100%; height: 100%;
      background-color: oklch(0 0 0 / 0.35);
      z-index: 0;
    }
    .content-container {
      position: relative; z-index: 1;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      height: 100vh; height: 100dvh;
      color: white; user-select: none;
      gap: 32px;
    }

    /* 时钟 */
    .clock-container { text-align: center; }
    .clock-container #clock {
      font-size: clamp(3rem, 8vw, 7rem);
      margin-bottom: 6px;
      text-shadow: 0 0 60px color-mix(in oklch, var(--primary) 30%, transparent),
                   0 0 120px color-mix(in oklch, var(--primary) 15%, transparent);
      font-weight: 200; letter-spacing: 4px;
    }
    .clock-container #date-text {
      font-size: clamp(0.9rem, 2vw, 1.3rem);
      opacity: 0.85;
    }

    /* 区块容器 */
    .player-section {
      display: flex; flex-direction: column; align-items: center;
    }

    /* 噪音类型选择 */
    .noise-selector {
      display: flex; gap: 12px;
      border-radius: 30px; padding: 10px 32px;
    }
    .noise-btn {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.5);
      padding: 12px 24px; border-radius: 25px;
      cursor: pointer; font-size: 16px;
      transition: all var(--duration-medium) var(--ease-standard);
      white-space: nowrap;
    }
    .noise-btn.active {
      background: transparent;
      color: var(--primary); font-weight: 600;
    }
    .noise-btn:hover:not(.active) {
      background: transparent; color: var(--primary);
    }

    /* 播放按钮 */
    .noise-card { display: flex; flex-direction: column; align-items: center; gap: 18px; }
    #play-btn {
      width: 80px; height: 80px;
      border-radius: 50%;
      background: color-mix(in oklch, var(--primary) 15%, transparent);
      border: 2px solid color-mix(in oklch, var(--primary) 35%, transparent);
      color: white; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all var(--duration-medium) var(--ease-standard);
      margin-bottom: 0;
    }
    #play-btn:hover {
      background: color-mix(in oklch, var(--primary) 25%, transparent);
      border-color: var(--primary);
      transform: scale(1.05);
    }
    #play-btn svg { width: 36px; height: 36px; }

    /* 音量 */
    .volume-row {
      display: flex; align-items: center; gap: 10px;
    }
    .volume-row svg { width: 20px; height: 20px; opacity: 0.6; }
    #volume-slider {
      -webkit-appearance: none; appearance: none;
      width: 140px; height: 4px; border-radius: 2px;
      background: oklch(1 0 0 / 0.25); outline: none;
    }
    #volume-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px; height: 18px; border-radius: 50%;
      background: var(--primary); cursor: pointer;
    }

    /* 底部按钮 */
    .bottom-controls {
      position: fixed; bottom: 28px;
      display: flex; gap: 12px; z-index: 10;
    }
    .bottom-controls.left { left: 28px; }
    .bottom-controls.right { right: 28px; }

    .ctrl-btn {
      background: transparent;
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.7); padding: 10px 20px;
      border-radius: 25px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      display: flex; align-items: center; gap: 6px;
    }
    .ctrl-btn:hover { background: transparent; color: var(--primary); }
    .ctrl-btn svg { width: 18px; height: 18px; }

    /* 返回按钮 - 左上角 */
    .back-btn {
      position: fixed; top: 24px; left: 24px; z-index: 10;
      background: transparent;
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.7); padding: 8px 16px;
      border-radius: 20px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      text-decoration: none; display: flex; align-items: center; gap: 4px;
    }
    .back-btn:hover { background: transparent; color: var(--primary); }
    .back-btn svg { width: 16px; height: 16px; }

    .hidden { display: none !important; }
    .flex { display: flex !important; }

    /* ---- 隐藏模式切换 ---- */
    .hide-toggle {
      position: fixed; top: 24px; right: 24px; z-index: 100;
      background: var(--btn-regular-bg);
      border: 1px solid var(--line-divider);
      color: oklch(1 0 0 / 0.65); padding: 8px 14px;
      border-radius: 20px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      display: flex; align-items: center; gap: 4px;
    }
    .hide-toggle:hover { color: var(--primary); }
    .hide-toggle svg { width: 16px; height: 16px; }

    /* ---- 右侧浮动面板 ---- */
    .whitenoise-page:not(.hide-mode) .floating-panel { display: none; }
    .whitenoise-page.hide-mode .floating-panel { display: flex; }
    .floating-panel {
      position: fixed; right: 0; top: 50%; z-index: 100;
      transform: translate(calc(100% - 36px), -50%);
      transition: transform 0.35s var(--ease-standard);
      align-items: stretch;
      max-height: 85vh;
    }
    .floating-panel.open {
      transform: translate(0, -50%);
    }
    .panel-tab {
      width: 36px; flex-shrink: 0;
      background: var(--float-panel-bg);
      border: 1px solid oklch(1 0 0 / 0.1);
      border-right: none;
      border-radius: 12px 0 0 12px;
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      color: oklch(1 0 0 / 0.5);
      transition: color 0.15s;
      padding: 0;
    }
    .panel-tab:hover { color: var(--primary); }
    .panel-tab svg { width: 20px; height: 20px; transition: transform 0.35s var(--ease-standard); }
    .floating-panel.open .panel-tab svg { transform: rotate(180deg); }

    .panel-body {
      background: var(--float-panel-bg);
      border: 1px solid oklch(1 0 0 / 0.1);
      border-left: none;
      border-radius: 0 12px 12px 0;
      padding: 20px 24px;
      display: flex; flex-direction: column; align-items: center;
      gap: 18px;
      overflow-y: auto;
    }
    .panel-body::-webkit-scrollbar { width: 4px; }
    .panel-body::-webkit-scrollbar-thumb {
      background: color-mix(in oklch, var(--primary) 20%, transparent); border-radius: 4px;
    }

    .panel-clock {
      font-size: 28px; font-weight: 200; letter-spacing: 3px;
      color: white;
      text-shadow: 0 0 20px color-mix(in oklch, var(--primary) 30%, transparent);
      font-variant-numeric: tabular-nums;
    }
    .panel-date {
      font-size: 11px; color: oklch(1 0 0 / 0.5); text-align: center;
      margin-top: -12px;
    }

    .panel-noise-selector {
      display: flex; flex-direction: column; gap: 6px;
    }
    .panel-noise-btn {
      background: transparent; border: none;
      color: oklch(1 0 0 / 0.45); padding: 8px 20px;
      border-radius: 18px; cursor: pointer;
      font-size: 13px;
      transition: all var(--duration-medium) var(--ease-standard);
      white-space: nowrap; text-align: center;
    }
    .panel-noise-btn.active { color: var(--primary); font-weight: 600; }
    .panel-noise-btn:hover:not(.active) { color: var(--primary); }

    .panel-play-btn {
      width: 52px; height: 52px; border-radius: 50%;
      background: color-mix(in oklch, var(--primary) 15%, transparent);
      border: 2px solid color-mix(in oklch, var(--primary) 35%, transparent);
      color: white; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      transition: all var(--duration-medium) var(--ease-standard);
    }
    .panel-play-btn:hover {
      background: color-mix(in oklch, var(--primary) 25%, transparent);
      border-color: var(--primary);
      transform: scale(1.05);
    }
    .panel-play-btn svg { width: 24px; height: 24px; }

    .panel-volume-row { display: flex; align-items: center; gap: 8px; }
    .panel-volume-row svg { width: 16px; height: 16px; opacity: 0.5; }
    .panel-volume-slider {
      -webkit-appearance: none; appearance: none;
      width: 100px; height: 3px; border-radius: 2px;
      background: oklch(1 0 0 / 0.25); outline: none;
    }
    .panel-volume-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 14px; height: 14px; border-radius: 50%;
      background: var(--primary); cursor: pointer;
    }

    /* 隐藏模式下隐藏主内容 */
    .whitenoise-page.hide-mode .content-container { display: none; }
    .whitenoise-page.hide-mode .back-btn { display: none; }
    .whitenoise-page.hide-mode .bottom-controls { display: none; }
  </style>
</head>
<body class="whitenoise-page">
  <script>!function(){var h=localStorage.getItem("hue");if(h)document.documentElement.style.setProperty("--hue",h)}();</script>

  <!-- 视频背景 -->
  <video id="video-bg" autoplay muted loop playsinline>
    <source src={rain2Video} type="video/mp4" />
  </video>
  <div class="video-fallback" id="video-fallback"></div>

  <!-- 半透明覆盖 -->
  <div class="overlay"></div>

  <!-- 主要内容 -->
  <div class="content-container">
    <!-- 时钟 -->
    <div class="clock-container">
      <div id="clock">00:00:00</div>
      <div id="date-text">加载中...</div>
    </div>

    <!-- 噪音类型选择 -->
    <div class="player-section">
      <div class="noise-selector" id="noise-selector">
        {noiseTypes.map((n, i) => (
          <button class={`noise-btn${i === 0 ? " active" : ""}`} data-noise={n.id} data-video={n.video} title={n.desc}>
            {n.label}
          </button>
        ))}
      </div>
    </div>

    <!-- 播放 + 音量卡片 -->
    <div class="player-section">
      <div class="noise-card">
        <button id="play-btn" title="播放 / 暂停">
          <span id="icon-play" class="flex">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          <span id="icon-stop" class="hidden">
            <svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
          </span>
        </button>
        <div class="volume-row">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3z"/></svg>
          <input type="range" id="volume-slider" min="0" max="100" value="40" />
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- 左上角返回 -->
  <a href="/tools/" class="back-btn">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/></svg>
    返回
  </a>

  <!-- 底部左侧: 全屏 -->
  <div class="bottom-controls left">
    <button class="ctrl-btn" id="toggle-fullscreen">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
      全屏
    </button>
  </div>


  <!-- 底部右侧: 提示 -->
  <div class="bottom-controls right">
    <span style="opacity:0.5;font-size:12px;color:oklch(1 0 0 / 0.5);">空格键 播放 · F键 全屏</span>
  </div>

  <!-- 隐藏模式切换按钮（始终可见，独立于 bottom-controls） -->
  <button class="hide-toggle" id="hide-toggle" title="隐藏界面">
    <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
  </button>

  <!-- 右侧浮动面板 -->
  <div class="floating-panel" id="floating-panel">
    <button class="panel-tab" id="panel-tab" title="收起面板">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
    </button>
    <div class="panel-body">
      <div class="panel-clock" id="panel-clock">00:00:00</div>
      <div class="panel-date" id="panel-date">加载中...</div>
      <div class="panel-noise-selector" id="panel-noise-selector">
        {noiseTypes.map((n, i) => (
          <button class={`panel-noise-btn${i === 0 ? " active" : ""}`} data-noise={n.id}>{n.label}</button>
        ))}
      </div>
      <button class="panel-play-btn" id="panel-play-btn" title="播放 / 暂停">
        <span id="panel-icon-play" class="flex">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span id="panel-icon-stop" class="hidden">
          <svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
        </span>
      </button>
      <div class="panel-volume-row">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3z"/></svg>
        <input type="range" class="panel-volume-slider" id="panel-volume-slider" min="0" max="100" value="40" />
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02z"/></svg>
      </div>
    </div>
  </div>

  <script is:inline>
    (function() {
      // DOM
      const playBtn = document.getElementById("play-btn");
      const iconPlay = document.getElementById("icon-play");
      const iconStop = document.getElementById("icon-stop");
      const volumeSlider = document.getElementById("volume-slider");
      const video = document.getElementById("video-bg");
      const videoFallback = document.getElementById("video-fallback");
      const fullscreenBtn = document.getElementById("toggle-fullscreen");

      // 从按钮 data 属性读取视频映射
      const videoMap = {};
      document.querySelectorAll(".noise-btn").forEach(btn => {
        videoMap[btn.dataset.noise] = btn.dataset.video;
      });

      // Web Audio
      let audioContext = null;
      let noiseSource = null;
      let gainNode = null;
      let filterNode = null;
      let isPlaying = false;
      let currentNoise = "white";

      // 视频加载失败时显示渐变背景
      video.addEventListener("error", () => {
        video.style.display = "none";
        videoFallback.style.display = "block";
      });

      function createNoiseBuffer(type) {
        const ctx = audioContext;
        const size = 2 * ctx.sampleRate;
        const buffer = ctx.createBuffer(1, size, ctx.sampleRate);
        const data = buffer.getChannelData(0);

        switch (type) {
          case "white":
            for (let i = 0; i < size; i++) data[i] = Math.random() * 2 - 1;
            break;
          case "pink": {
            let b0=0,b1=0,b2=0,b3=0,b4=0,b5=0,b6=0;
            for (let i = 0; i < size; i++) {
              const w = Math.random() * 2 - 1;
              b0 = 0.99886*b0 + w*0.0555179;
              b1 = 0.99332*b1 + w*0.0750759;
              b2 = 0.96900*b2 + w*0.1538520;
              b3 = 0.86650*b3 + w*0.3104856;
              b4 = 0.55000*b4 + w*0.5329522;
              b5 = -0.7616*b5 - w*0.0168980;
              data[i] = (b0+b1+b2+b3+b4+b5+b6 + w*0.5362) * 0.11;
              b6 = w * 0.115926;
            }
            break;
          }
          case "brown": {
            let last = 0;
            for (let i = 0; i < size; i++) {
              const w = Math.random() * 2 - 1;
              data[i] = (last + 0.02*w) / 1.02;
              last = data[i];
              data[i] *= 3.5;
            }
            break;
          }
        }
        return buffer;
      }

      function startNoise() {
        if (!audioContext) {
          audioContext = new (window.AudioContext || window.webkitAudioContext)();
        }
        stopNoise();

        const buffer = createNoiseBuffer(currentNoise);
        noiseSource = audioContext.createBufferSource();
        noiseSource.buffer = buffer;
        noiseSource.loop = true;

        filterNode = audioContext.createBiquadFilter();
        filterNode.type = "lowpass";
        filterNode.frequency.value = currentNoise === "white" ? 8000 : currentNoise === "pink" ? 2000 : 800;

        gainNode = audioContext.createGain();
        gainNode.gain.value = parseInt(volumeSlider.value) / 100 * 0.4;

        noiseSource.connect(filterNode);
        filterNode.connect(gainNode);
        gainNode.connect(audioContext.destination);
        noiseSource.start(0);
      }

      function stopNoise() {
        if (noiseSource) {
          try { noiseSource.stop(); } catch(e) {}
          noiseSource.disconnect();
          noiseSource = null;
        }
        if (filterNode) { filterNode.disconnect(); filterNode = null; }
        if (gainNode) { gainNode.disconnect(); gainNode = null; }
      }

      function updatePlayIcons(playing) {
        if (playing) {
          iconPlay.classList.add("hidden"); iconPlay.classList.remove("flex");
          iconStop.classList.remove("hidden"); iconStop.classList.add("flex");
        } else {
          iconPlay.classList.remove("hidden"); iconPlay.classList.add("flex");
          iconStop.classList.add("hidden"); iconStop.classList.remove("flex");
        }
        // 同步面板图标
        const pi = document.getElementById("panel-icon-play");
        const ps = document.getElementById("panel-icon-stop");
        if (pi && ps) {
          if (playing) {
            pi.classList.add("hidden"); pi.classList.remove("flex");
            ps.classList.remove("hidden"); ps.classList.add("flex");
          } else {
            pi.classList.remove("hidden"); pi.classList.add("flex");
            ps.classList.add("hidden"); ps.classList.remove("flex");
          }
        }
      }
      function togglePlay() {
        if (isPlaying) {
          stopNoise();
          isPlaying = false;
        } else {
          startNoise();
          isPlaying = true;
        }
        updatePlayIcons(isPlaying);
      }

      playBtn.addEventListener("click", togglePlay);

      volumeSlider.addEventListener("input", () => {
        if (gainNode) {
          gainNode.gain.value = parseInt(volumeSlider.value) / 100 * 0.4;
        }
      });

      // 噪音类型切换
      document.querySelectorAll(".noise-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll(".noise-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          const newNoise = btn.dataset.noise;
          if (newNoise !== currentNoise) {
            currentNoise = newNoise;
            // 切换视频背景
            const newVideoSrc = videoMap[currentNoise];
            if (newVideoSrc) {
              const srcEl = video.querySelector("source");
              srcEl.setAttribute("src", newVideoSrc);
              video.load();
              video.play().catch(() => {});
            }
            if (isPlaying) {
              stopNoise();
              startNoise();
            }
          }
        });
      });

      // 全屏
      function updateFullscreenUI() {
        const isFS = !!(document.fullscreenElement || document.webkitFullscreenElement
          || document.mozFullScreenElement || document.msFullscreenElement);
        fullscreenBtn.innerHTML = isFS
          ? '<svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px"><path d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>退出全屏'
          : '<svg viewBox="0 0 24 24" fill="currentColor" style="width:18px;height:18px"><path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>全屏';
      }

      fullscreenBtn.addEventListener("click", () => {
        if (!document.fullscreenElement && !document.webkitFullscreenElement
          && !document.mozFullScreenElement && !document.msFullscreenElement) {
          const el = document.documentElement;
          (el.requestFullscreen || el.webkitRequestFullscreen
            || el.mozRequestFullScreen || el.msRequestFullscreen).call(el);
        } else {
          (document.exitFullscreen || document.webkitExitFullscreen
            || document.mozCancelFullScreen || document.msExitFullscreen).call(document);
        }
      });

      document.addEventListener("fullscreenchange", updateFullscreenUI);
      document.addEventListener("webkitfullscreenchange", updateFullscreenUI);

      // 时钟（含面板同步）
      const panelClock = document.getElementById("panel-clock");
      const panelDate = document.getElementById("panel-date");
      function updateClock() {
        const now = new Date();
        const timeStr = [now.getHours(), now.getMinutes(), now.getSeconds()]
          .map(n => String(n).padStart(2, "0")).join(":");
        const dateStr = now.toLocaleDateString("zh-CN", {
          weekday: "long", year: "numeric", month: "long", day: "numeric"
        });
        document.getElementById("clock").textContent = timeStr;
        document.getElementById("date-text").textContent = dateStr;
        panelClock.textContent = timeStr;
        panelDate.textContent = dateStr;
      }
      updateClock();
      setInterval(updateClock, 1000);

      // ---- 隐藏模式 & 浮动面板 ----
      const page = document.querySelector(".whitenoise-page");
      const hideToggle = document.getElementById("hide-toggle");
      const hideToggleSvg = hideToggle.querySelector("svg");
      const floatingPanel = document.getElementById("floating-panel");
      const panelTab = document.getElementById("panel-tab");
      const panelPlayBtn = document.getElementById("panel-play-btn");
      const panelVolumeSlider = document.getElementById("panel-volume-slider");
      let hideMode = false;

      const EYE_OPEN = '<path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/>';
      const EYE_CLOSE = '<path d="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/>';

      hideToggle.addEventListener("click", () => {
        hideMode = !hideMode;
        if (hideMode) {
          page.classList.add("hide-mode");
          floatingPanel.classList.add("open");
          hideToggleSvg.innerHTML = EYE_CLOSE;
          hideToggle.title = "显示界面";
        } else {
          page.classList.remove("hide-mode");
          floatingPanel.classList.remove("open");
          hideToggleSvg.innerHTML = EYE_OPEN;
          hideToggle.title = "隐藏界面";
        }
      });

      panelTab.addEventListener("click", () => {
        floatingPanel.classList.toggle("open");
      });

      // 面板噪音选择
      document.querySelectorAll("#panel-noise-selector .panel-noise-btn").forEach(btn => {
        btn.addEventListener("click", () => {
          document.querySelectorAll("#panel-noise-selector .panel-noise-btn").forEach(b => b.classList.remove("active"));
          btn.classList.add("active");
          const newNoise = btn.dataset.noise;
          // 同步主噪音按钮
          document.querySelectorAll("#noise-selector .noise-btn").forEach(b => b.classList.remove("active"));
          const mainBtn = document.querySelector(`#noise-selector .noise-btn[data-noise="${newNoise}"]`);
          if (mainBtn) { mainBtn.classList.add("active"); mainBtn.click(); }
        });
      });

      // 同步主噪音按钮点击到面板
      document.querySelectorAll("#noise-selector .noise-btn").forEach(btn => {
        const origClick = btn.onclick;
        btn.addEventListener("click", () => {
          const noise = btn.dataset.noise;
          document.querySelectorAll("#panel-noise-selector .panel-noise-btn").forEach(b => {
            b.classList.toggle("active", b.dataset.noise === noise);
          });
        });
      });

      // 面板播放按钮
      panelPlayBtn.addEventListener("click", () => {
        playBtn.click();
      });

      // 面板音量同步
      panelVolumeSlider.addEventListener("input", () => {
        volumeSlider.value = panelVolumeSlider.value;
        if (gainNode) {
          gainNode.gain.value = parseInt(volumeSlider.value) / 100 * 0.4;
        }
      });
      volumeSlider.addEventListener("input", () => {
        panelVolumeSlider.value = volumeSlider.value;
      });

      // 键盘快捷键
      document.addEventListener("keydown", (e) => {
        if (e.code === "Space" && e.target === document.body) {
          e.preventDefault();
          togglePlay();
        } else if (e.code === "KeyF" && e.target === document.body) {
          e.preventDefault();
          fullscreenBtn.click();
        }
      });
    })();
  </script>
</body>
</html>
