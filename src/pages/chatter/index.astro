---
import Layout from "@/layouts/Layout.astro";
import Navbar from "@/components/layout/Navbar.astro";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import BackgroundEffects from "@/components/effects/BackgroundEffects.svelte";
import MomentList from "@/components/homepage/MomentList.svelte";
import { profileConfig } from "@/config/profileConfig";
import { backgroundWallpaper, live2dWidgetConfig, siteConfig } from "@/config";
import Live2DWidget from "@/components/features/Live2DWidget.astro";
import SpineModel from "@/components/features/SpineModel.astro";
import { getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import { markdownToHtml } from "@/utils/markdown-to-html";
import Footer from "@/components/layout/Footer.astro";
import "@/styles/moment-list.css";

const allChatters = await getCollection("chatters", ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const chatters = await Promise.all(
  allChatters
    .sort((a, b) => {
      if (a.data.pinned && !b.data.pinned) return -1;
      if (!a.data.pinned && b.data.pinned) return 1;
      return new Date(b.data.published).getTime() - new Date(a.data.published).getTime();
    })
    .map(async (c) => ({
      id: c.id,
      data: c.data,
      body: c.body,
      bodyHtml: await markdownToHtml(c.body || ""),
    }))
);

const avatarModules = import.meta.glob<ImageMetadata>(
  "/src/assets/images/*.{avif,webp,jpg,jpeg,png,gif,svg}",
  { eager: true, import: "default" },
);
function resolveAvatarSrc(path: string): string {
  if (!path) return "";
  if (path.startsWith("http://") || path.startsWith("https://") || path.startsWith("/")) {
    return path;
  }
  const cleanPath = path.replace(/^\.\//, "");
  const filename = cleanPath.split("/").pop() || cleanPath;
  for (const [globPath, mod] of Object.entries(avatarModules)) {
    if (globPath.endsWith("/" + filename)) {
      return mod.src;
    }
  }
  return path;
}
const avatarSrc = resolveAvatarSrc(profileConfig.avatar || "");

// Background wallpaper (same as homepage)
const backgroundImages = backgroundWallpaper.src;
let bgImage = "";
let bgImageMobile = "";
if (
  typeof backgroundImages === "object" &&
  backgroundImages !== null &&
  !Array.isArray(backgroundImages) &&
  "desktop" in backgroundImages
) {
  const d = backgroundImages.desktop;
  const m = backgroundImages.mobile;
  if (Array.isArray(d)) bgImage = d[Math.floor(Math.random() * d.length)];
  else if (d) bgImage = d;
  if (Array.isArray(m)) bgImageMobile = m[Math.floor(Math.random() * m.length)];
  else if (m) bgImageMobile = m;
  else bgImageMobile = bgImage;
} else if (typeof backgroundImages === "string") {
  bgImage = backgroundImages;
  bgImageMobile = backgroundImages;
}

const themeColors = ["#a18cd1", "#fbc2eb", "#a1c4fd", "#c2e9fb"];

const stickyNavbar = siteConfig.navbar.stickyNavbar ?? false;
const navbarWidthFull = siteConfig.navbar.widthFull ?? false;

---

<Layout title="说说" description="微言碎语，记录日常">
  <script is:inline>document.body.classList.add("is-standalone")</script>
  <div id="banner-overlay-container" style="display:none"></div>
  <div id="banner-dim-container" style="display:none"></div>
  <div id="left-sidebar-dynamic" style="display:none"></div>
  <div id="swup-container">
  <!-- Fixed Background Layer (same as homepage) -->
  <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden">
    {bgImageMobile && (
      <div class="absolute inset-0 block lg:hidden">
        <ImageWrapper
          src={bgImageMobile}
          alt=""
          class="!absolute !inset-0 !w-full !h-full"
          loading="eager"
          fetchpriority="high"
          widths={[640, 750, 1080]}
          sizes="100vw"
        />
      </div>
    )}
    {bgImage && (
      <div class="absolute inset-0 hidden lg:block">
        <ImageWrapper
          src={bgImage}
          alt=""
          class="!absolute !inset-0 !w-full !h-full"
          loading="eager"
          fetchpriority="high"
          widths={[1280, 1920, 2560]}
          sizes="100vw"
        />
      </div>
    )}

    <!-- Frosted Glass Overlay -->
    <div class="absolute inset-0 z-[1] bg-white/30 dark:bg-slate-900/40 backdrop-blur-md transition-colors duration-1000"></div>

    <!-- Animated Gradient -->
    <div
      class="absolute inset-0 z-[2] opacity-60 dark:opacity-20 mix-blend-color transition-opacity duration-1000"
      style={`background: linear-gradient(-45deg, ${themeColors.join(", ")}); background-size: 400% 400%; animation: chatterGradientMove 15s ease infinite;`}
    ></div>

    <!-- Glow Orbs -->
    <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-white/40 dark:bg-indigo-900/20 blur-[100px] rounded-full z-[3] md:mix-blend-overlay"></div>
    <div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-indigo-400/30 dark:bg-purple-900/30 blur-[100px] rounded-full z-[3] md:mix-blend-overlay"></div>
  </div>

  <!-- 萤火虫/樱花特效 -->
  <BackgroundEffects client:load />

    <!-- Navbar -->
  <div
    id="top-row"
    class="z-50 pointer-events-none relative transition-all duration-700 mx-auto"
    class:list={[
      stickyNavbar ? "h-18 fixed top-0 left-0 right-0 z-80" : "",
      navbarWidthFull ? "" : "w-full xl:w-[92vw] max-w-(--page-width) px-0 md:px-4",
    ]}
  >
    <div
      id="navbar-wrapper"
      class:list={[
        "pointer-events-auto transition-all",
        stickyNavbar ? "" : "sticky top-0",
      ]}
    >
      <Navbar />
    </div>
  </div>

  <main class="relative z-10 min-h-screen pt-24 md:pt-28 pb-10">
    <MomentList
      essays={chatters}
      authorName={profileConfig.name}
      avatarUrl={avatarSrc}
      client:load
    />
  </main>

  <SpineModel></SpineModel>
  {live2dWidgetConfig.enable && <Live2DWidget config={live2dWidgetConfig} />}
  <Footer />
  </div>
  <div id="right-sidebar-dynamic" style="display:none"></div>
  <div id="floating-toc-wrapper" style="display:none"></div>
</Layout>

<style is:global>
  @keyframes chatterGradientMove {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }


	[data-chatter-card] {
		border-radius: 1.5rem 1.5rem 1.5rem 0.25rem;
		border-color: rgba(255,255,255,0.55);
	}
	.dark [data-chatter-card] {
		border-color: rgba(255,255,255,0.12);
	}
	@media (min-width: 768px) {
		[data-chatter-card] {
			border-radius: 2.25rem 2.25rem 2.25rem 0.35rem;
		}
	}
	@media (min-width: 1024px) {
		[data-chatter-card] {
			border-radius: 2.5rem 2.5rem 2.5rem 0.4rem;
		}
	}

	[data-chatter-accent] {
		height: 3px;
		width: 2.5rem;
		border-radius: 9999px;
		background: linear-gradient(to right, var(--primary), #f472b6, #fbbf24);
		margin: 0.25rem 0 0.5rem;
		opacity: 0.7;
	}

	[data-chatter-divider] {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0.25rem 0 0.75rem;
		font-size: 0.55rem;
		color: var(--primary);
		opacity: 0.35;
	}
	[data-chatter-divider]::before,
	[data-chatter-divider]::after {
		content: "";
		flex: 1;
		height: 1px;
		border-radius: 1px;
	}
	[data-chatter-divider]::before {
		background: linear-gradient(to right, transparent, color-mix(in oklch, var(--primary) 30%, transparent));
	}
	[data-chatter-divider]::after {
		background: linear-gradient(to right, color-mix(in oklch, #f472b6 30%, transparent), transparent);
	}

	/* ── 说说卡片内容排版样式（独立于 markdown.css）── */
	[data-full-content] a:not(.no-styling) {
		position: relative;
		background: none;
		font-weight: 500;
		color: var(--primary);
		text-decoration: underline;
		text-decoration-color: var(--link-underline);
		text-decoration-thickness: 1px;
		text-decoration-style: dashed;
		text-underline-offset: 4px;
		word-break: break-word;
	}
	[data-full-content] a:not(.no-styling):hover {
		text-decoration: none;
		background: var(--btn-plain-bg-hover);
		border-bottom: 1px dashed var(--link-hover);
	}

	[data-full-content] code {
		background: var(--inline-code-bg);
		color: var(--inline-code-color);
		padding: 0.125rem 0.25rem;
		border-radius: 0.375rem;
		font-family: "JetBrains Mono Variable", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
	}
	[data-full-content] code::before,
	[data-full-content] code::after { content: none; }

	[data-full-content] blockquote:not(.callout) {
		font-style: normal;
		border-color: transparent;
		position: relative;
		font-weight: inherit;
	}
	[data-full-content] blockquote:not(.callout)::before {
		content: "";
		position: absolute;
		left: -0.25rem;
		display: block;
		background: var(--btn-regular-bg);
		height: 100%;
		width: 0.25rem;
		border-radius: 9999px;
	}
	[data-full-content] blockquote:not(.callout) p::before,
	[data-full-content] blockquote:not(.callout) p::after { content: none; }

	[data-full-content] ul li::marker,
	[data-full-content] ol li::marker {
		color: var(--primary);
	}

	[data-full-content] img {
		border-radius: 0.75rem;
	}

	[data-full-content] hr {
		border-color: var(--line-divider);
		border-style: dashed;
	}

	[data-full-content] table {
		border-collapse: separate;
		border-spacing: 0;
		border-radius: calc(var(--radius-large) - 0.5rem);
		overflow: hidden;
		margin: 1rem 0;
		width: 100%;
	}
	[data-full-content] th {
		background: var(--btn-regular-bg);
		font-weight: 600;
		color: var(--btn-content);
		border-bottom: 1px solid var(--line-color);
	}
	[data-full-content] td {
		background: var(--card-bg);
	}
	[data-full-content] tr:nth-child(even) td {
		background: var(--btn-plain-bg-active);
	}
	[data-full-content] th,
	[data-full-content] td {
		padding: 0.5rem 0.75rem;
		text-align: left;
		word-break: break-word;
	}
	[data-full-content] th:not(:last-child),
	[data-full-content] td:not(:last-child) {
		border-right: 1px solid var(--line-color);
	}

</style>
